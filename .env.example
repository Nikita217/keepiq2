APP_ENV=development
APP_NAME=KeepIQ
API_HOST=127.0.0.1
API_PORT=8000
MINI_APP_DEV_URL=http://localhost:5173
MINI_APP_PUBLIC_URL=https://your-mini-app-domain.example
BOT_TOKEN=replace_me
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_AUDIO_MODEL=gpt-4o-mini-transcribe
DATABASE_URL=sqlite+aiosqlite:///./keepiq.db
LOCAL_STORAGE_ROOT=./uploads
TIMEZONE=Europe/Moscow
WEBHOOK_BASE_URL=
USE_WEBHOOK=false
OCR_ENABLED=true
VOICE_TRANSCRIPTION_ENABLED=true
INIT_DATA_MAX_AGE_SECONDS=3600
DEFAULT_REMINDER_LEAD_HOURS=3
MORNING_DIGEST_ENABLED=true
MORNING_DIGEST_TIME=09:00
EVENING_DIGEST_ENABLED=true
EVENING_DIGEST_TIME=20:30
